{
  "name": "dimed-uz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dimed klinikasi sayti — Astro + Tailwind + Netlify Functions",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit -p netlify/tsconfig.json",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --experimental-strip-types scripts/test-lib.mjs && node --experimental-strip-types scripts/test-slots.mjs && node --experimental-strip-types scripts/test-appointments.mjs && node --experimental-strip-types scripts/test-schedule.mjs",
    "test:api": "node --experimental-strip-types scripts/test-api.mjs",
    "create-tables": "node scripts/create-tables.mjs",
    "seed-doctors": "node --experimental-strip-types scripts/seed-doctors.mjs",
    "build-analyses": "node scripts/build-analyses.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@netlify/functions": "^2.8.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  }
}
