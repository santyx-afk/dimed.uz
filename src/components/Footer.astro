---
import Logo from './Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="wrap">
  <div class="foot-in">
    <Logo height={22} />
    <p>
      © {year} Dimed klinikasi ·
      <a class="foot-link" href={site.mapsUrl} target="_blank" rel="noopener">{site.address}</a>
      <span class="sep" aria-hidden="true">·</span>
      <a class="foot-link" href="/maxfiylik">Maxfiylik siyosati</a>
    </p>
    <div class="foot-soc">
      <a href={site.telegramBot} target="_blank" rel="noopener" aria-label="Telegram">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M21.9 4.1c.3-1.2-.9-2.2-2-1.7L2.7 9.2c-1.2.5-1.1 2.2.1 2.6l4.4 1.4 1.7 5.3c.4 1.1 1.8 1.4 2.6.5l2.4-2.5 4.6 3.4c1 .7 2.4.2 2.6-1L21.9 4.1z"
          ></path></svg
        >
      </a>
      <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.3.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.3.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.9-.2-2.3-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.3-.1-1.2-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.2-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.3-.4 1.2-.1 1.6-.1 4.8-.1zm0 2c-3.1 0-3.5 0-4.7.1-1.1.1-1.5.2-1.8.3-.4.2-.7.3-.9.6-.3.3-.5.5-.6.9-.1.3-.3.7-.3 1.8-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.5.3 1.8.2.4.3.7.6.9.3.3.5.5.9.6.3.1.7.3 1.8.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.5-.2 1.8-.3.4-.2.7-.3.9-.6.3-.3.5-.5.6-.9.1-.3.3-.7.3-1.8.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.5-.3-1.8-.2-.4-.3-.7-.6-.9-.3-.3-.5-.5-.9-.6-.3-.1-.7-.3-1.8-.3-1.2-.1-1.6-.1-4.7-.1zm0 3.4a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.2-2.2a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"
          ></path></svg
        >
      </a>
      <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H7.6V13h2.8v8h3.1z"
          ></path></svg
        >
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: var(--sp-5) 0 var(--sp-6);
    border-top: 1px solid var(--line);
    margin-top: var(--sp-5);
  }

  .foot-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .foot-in p {
    font-size: 13px;
    color: var(--muted);
  }

  .sep {
    margin: 0 8px;
  }

  .foot-link {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .foot-link:hover {
    color: var(--rose);
  }

  .foot-soc {
    display: flex;
    gap: 8px;
  }

  .foot-soc a {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--chip-bg);
    border: 1px solid var(--card-brd);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s;
  }

  .foot-soc a:hover {
    border-color: var(--rose);
  }

  .foot-soc svg {
    width: 16px;
    height: 16px;
    fill: var(--muted);
  }

  .foot-soc a:hover svg {
    fill: var(--rose);
  }
</style>
