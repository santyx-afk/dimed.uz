  brain:
    '<path d="M9.5 3.5A3.5 3.5 0 0 0 6 7v.3A3.8 3.8 0 0 0 4 11a3.8 3.8 0 0 0 1.5 3A3.6 3.6 0 0 0 8 20.4c.8 0 1.5-.2 2-.7.4.5 1.1.8 2 .8V3.5h-2.5z"/><path d="M14.5 3.5A3.5 3.5 0 0 1 18 7v.3A3.8 3.8 0 0 1 20 11a3.8 3.8 0 0 1-1.5 3 3.6 3.6 0 0 1-2.5 6.4c-.8 0-1.5-.2-2-.7"/>',
