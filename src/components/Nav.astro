---
import Logo from './Logo.astro';

const links = [
  { href: '/#bolimlar', label: 'Boʻlimlar' },
  { href: '/#shifokorlar', label: 'Shifokorlar' },
  { href: '/#qanday', label: 'Qanday ishlaydi' },
  { href: '/tahlillar', label: 'Tahlillar' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---

<nav class="nav wrap">
  <div class="nav-in glass">
    <a class="nav-logo" href="/" aria-label="Dimed bosh sahifa">
      <Logo height={26} label="Dimed logotipi" />
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <a class="btn btn-sm nav-cta" href="/#navbat-widget">Navbat olish</a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 12px 0;
  }

  .nav-in {
    display: flex;
    align-items: center;
    gap: 26px;
    border-radius: 16px;
    padding: 10px 18px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 20px;
    margin-left: auto;
    font-size: 14.5px;
    font-weight: 500;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--ink);
  }

  .nav-cta {
    margin-left: auto;
  }

  .nav-links + .nav-cta {
    margin-left: 0;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }
</style>
