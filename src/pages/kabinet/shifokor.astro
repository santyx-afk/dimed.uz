---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Shifokor kabineti — Dimed klinikasi"
  description="Smenalar, tanaffuslar, qabul davomiyligi va bugungi navbat."
>
  <section class="wrap page">
    <div class="head">
      <div>
        <div class="eyebrow">Shifokor kabineti</div>
        <h1 id="title">Jadval sozlamalari</h1>
        <span class="sub" id="subtitle"></span>
      </div>
      <button class="btn btn-ghost btn-sm" id="logout" hidden>Chiqish</button>
    </div>

    <div id="loading" class="state">Yuklanmoqda…</div>

    <div id="denied" class="state" hidden>
      <p id="deniedText">Bu bo‘lim faqat shifokorlar uchun.</p>
      <a class="btn" href="/kirish">Kirish</a>
    </div>

    <div id="content" class="grid" hidden>
      <div class="card glass">
        <h2>Smenalar va tanaffuslar</h2>
        <div id="shifts"></div>
        <button class="add" id="addShift">+ smena qoʻshish</button>

        <h2 class="mt">Qabul davomiyligi</h2>
        <div class="seg" id="slotSeg">
          {[10, 15, 20, 30].map((m) => <button type="button" data-min={m}>{m} daq</button>)}
        </div>

        <p class="note">
          Oʻzgarishlar faqat kelgusidagi boʻsh slotlarga taʼsir qiladi — band qilingan navbatlar
          saqlanadi.
        </p>

        <p class="msg" id="msg" role="status" aria-live="polite"></p>
        <button class="btn" id="save">Saqlash</button>
      </div>

      <div class="card glass">
        <h2>Bugungi navbat · <span id="todayLabel"></span></h2>
        <div id="queue"></div>

        <h2 class="mt">Ishga chiqa olmasangiz</h2>
        <p class="note">
          Kun yopiladi, oʻsha kundagi barcha navbatlar bekor qilinadi va har bir bemorga
          Telegram orqali xabar boradi. Bu amalni qaytarib boʻlmaydi.
        </p>
        <div class="off-lab">Sana</div>
        <div class="off-days" id="offDays"></div>
        <p class="msg" id="offMsg" role="status" aria-live="polite"></p>
        <button class="btn btn-ghost danger" id="offBtn">Ishga chiqa olmayman</button>
      </div>
    </div>
  </section>
</Base>

<script>
  type Shift = { start: string; end: string };
  type Appointment = { time: string; phone: string; status: string };
  type Data = {
    doctor: { name: string; job: string; shifts: Shift[]; slotMinutes: number };
    today: string;
    slots: string[];
    appointments: Appointment[];
  };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let shifts: Shift[] = [];
  let slotMinutes = 15;

  /*
    Sana brauzer kalendarisiz tanlanadi: brauzerniki qurilma tilida
    (ko'pchilikda ruscha) ochiladi, tugmalar esa har doim o'zbekcha.
  */
  const WD = ['Yak', 'Du', 'Se', 'Chor', 'Pay', 'Ju', 'Sh'];
  const OYLAR = ['yan', 'fev', 'mar', 'apr', 'may', 'iyn', 'iyl', 'avg', 'sen', 'okt', 'noy', 'dek'];
  let offDate = '';

  function renderOffDays(todayKey: string) {
    const [y, m, d] = todayKey.split('-').map(Number);
    const today = new Date(y, m - 1, d);
    const pad = (n: number) => String(n).padStart(2, '0');

    let html = '';
    for (let i = 0; i < 14; i++) {
      const day = new Date(today);
      day.setDate(today.getDate() + i);
      const value = `${day.getFullYear()}-${pad(day.getMonth() + 1)}-${pad(day.getDate())}`;
      html += `<button class="off-day${value === offDate ? ' on' : ''}" data-value="${value}">
        ${WD[day.getDay()]}<b>${day.getDate()}</b><small>${OYLAR[day.getMonth()]}</small>
      </button>`;
    }

    const box = el('offDays');
    box.innerHTML = html;
    box.querySelectorAll<HTMLButtonElement>('.off-day').forEach((b) =>
      b.addEventListener('click', () => {
        offDate = b.dataset.value ?? '';
        renderOffDays(todayKey);
      }),
    );
  }

  const setMsg = (text: string, kind: 'error' | 'ok' | '' = '') => {
    const msg = el('msg');
    msg.textContent = text;
    msg.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  const setOffMsg = (text: string, kind: 'error' | 'ok' | '' = '') => {
    const msg = el('offMsg');
    msg.textContent = text;
    msg.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  async function load() {
    let data: Data;
    try {
      const res = await fetch('/api/doctor-schedule', { credentials: 'same-origin' });
      if (res.status === 401 || res.status === 403) {
        el('loading').hidden = true;
        el('denied').hidden = false;
        if (res.status === 403) {
          el('deniedText').textContent =
            'Bu hisob shifokor sifatida roʻyxatdan oʻtmagan. Administratorga murojaat qiling.';
        }
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      data = await res.json();
    } catch {
      el('loading').textContent = 'Maʼlumotlarni yuklab boʻlmadi. Sahifani yangilang.';
      return;
    }

    el('loading').hidden = true;
    el('content').hidden = false;
    el('logout').hidden = false;

    el('title').textContent = data.doctor.name;
    el('subtitle').textContent = data.doctor.job;
    el('todayLabel').textContent = data.today;

    offDate = data.today;
    renderOffDays(data.today);

    shifts = data.doctor.shifts.map((s) => ({ ...s }));
    slotMinutes = data.doctor.slotMinutes;
    renderShifts();
    renderSlotSeg();
    renderQueue(data);
  }

  function renderShifts() {
    el('shifts').innerHTML = shifts
      .map(
        (s, i) => `<div class="shift">
          <input type="time" value="${s.start}" data-i="${i}" data-k="start" aria-label="${i + 1}-smena boshlanishi">
          <span class="dash">–</span>
          <input type="time" value="${s.end}" data-i="${i}" data-k="end" aria-label="${i + 1}-smena tugashi">
          <button class="del" data-del="${i}" aria-label="Smenani oʻchirish">✕</button>
        </div>
        ${gapLabel(i)}`,
      )
      .join('');

    el('shifts')
      .querySelectorAll<HTMLInputElement>('input[data-i]')
      .forEach((input) =>
        input.addEventListener('change', () => {
          const shift = shifts[Number(input.dataset.i)];
          if (shift) shift[input.dataset.k as 'start' | 'end'] = input.value;
          renderShifts();
        }),
      );

    el('shifts')
      .querySelectorAll<HTMLButtonElement>('[data-del]')
      .forEach((btn) =>
        btn.addEventListener('click', () => {
          if (shifts.length === 1) {
            setMsg('Kamida bitta smena qolishi kerak.', 'error');
            return;
          }
          shifts.splice(Number(btn.dataset.del), 1);
          renderShifts();
        }),
      );
  }

  /** Ikki smena orasidagi bo'shliq — tanaffus. */
  function gapLabel(i: number) {
    const current = shifts[i];
    const next = shifts[i + 1];
    if (!current || !next) return '';
    return current.end < next.start
      ? `<div class="gap">tanaffus ${current.end} – ${next.start}</div>`
      : '';
  }

  function renderSlotSeg() {
    el('slotSeg')
      .querySelectorAll<HTMLButtonElement>('button')
      .forEach((btn) => {
        btn.classList.toggle('on', Number(btn.dataset.min) === slotMinutes);
        btn.onclick = () => {
          slotMinutes = Number(btn.dataset.min);
          renderSlotSeg();
        };
      });
  }

  function renderQueue(data: Data) {
    const byTime = new Map(data.appointments.map((a) => [a.time, a]));
    el('queue').innerHTML = data.slots.length
      ? data.slots
          .map((time) => {
            const a = byTime.get(time);
            const who = a
              ? `<span class="who">${a.phone}</span><span class="pill ${a.status === 'hold' ? 'warn' : 'ok'}">${
                  a.status === 'hold' ? 'kutilmoqda' : 'band'
                }</span>`
              : '<span class="who empty">boʻsh</span>';
            return `<div class="q"><span class="tm">${time}</span>${who}</div>`;
          })
          .join('')
      : '<p class="empty">Bugun qabul yoʻq.</p>';
  }

  el('addShift').addEventListener('click', () => {
    const last = shifts.at(-1);
    shifts.push(last ? { start: last.end, end: last.end } : { start: '09:00', end: '13:00' });
    renderShifts();
    setMsg('');
  });

  el('save').addEventListener('click', async () => {
    const btn = el<HTMLButtonElement>('save');
    btn.disabled = true;
    setMsg('Saqlanmoqda…');
    try {
      const res = await fetch('/api/doctor-schedule', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ shifts, slotMinutes }),
      });
      const data = (await res.json()) as { error?: string };
      if (res.ok) setMsg('Jadval saqlandi.', 'ok');
      else setMsg(data.error ?? 'Saqlab boʻlmadi.', 'error');
    } catch {
      setMsg('Internetga ulanishda muammo.', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  el('offBtn').addEventListener('click', async () => {
    const btn = el<HTMLButtonElement>('offBtn');
    const date = offDate;
    if (!date) {
      setOffMsg('Sanani tanlang.', 'error');
      return;
    }

    // Bekor qilingan navbatlarni qaytarib bo'lmaydi — shuning uchun so'raymiz.
    if (!confirm(`${date} kunidagi barcha navbatlar bekor qilinsinmi?\nBemorlarga xabar boradi.`)) {
      return;
    }

    btn.disabled = true;
    setOffMsg('Bajarilmoqda…');
    try {
      const res = await fetch('/api/doctor-off', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ date }),
      });
      const data = (await res.json()) as { cancelled?: number; notified?: number; error?: string };

      if (!res.ok) {
        setOffMsg(data.error ?? 'Bajarib boʻlmadi.', 'error');
        return;
      }

      setOffMsg(
        `Kun yopildi. Bekor qilingan navbatlar: ${data.cancelled ?? 0}, xabar berildi: ${data.notified ?? 0}.`,
        'ok',
      );
      await load();
    } catch {
      setOffMsg('Internetga ulanishda muammo.', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  el('logout').addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST', credentials: 'same-origin' }).catch(() => {});
    window.location.href = '/';
  });

  load();
</script>

<style>
  .page {
    padding: 48px 0 64px;
    min-height: 60vh;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  h1 {
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 750;
  }

  .sub {
    display: block;
    color: var(--rose);
    font-weight: 650;
    font-size: 14px;
    margin-top: 4px;
  }

  .state {
    text-align: center;
    padding: 40px 0;
    color: var(--muted);
    font-size: 15px;
  }

  .state .btn {
    margin-top: 16px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    border-radius: 18px;
    padding: 22px;
  }

  .card h2 {
    font-size: 12px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    font-family: var(--font-sans);
    margin-bottom: 14px;
  }

  .card h2.mt {
    margin-top: 22px;
  }

  .card :global(.shift) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .card :global(.shift input) {
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    color: var(--ink);
    border-radius: 10px;
    padding: 8px 11px;
    font: inherit;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .card :global(.shift input:focus) {
    border-color: var(--leaf);
    outline: none;
  }

  .card :global(.dash) {
    color: var(--muted);
  }

  .card :global(.del) {
    margin-left: auto;
    border: none;
    background: none;
    color: var(--muted);
    font-size: 14px;
    padding: 6px 8px;
    border-radius: 8px;
  }

  .card :global(.del:hover) {
    color: var(--rose);
    background: var(--rose-soft);
  }

  .card :global(.gap) {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    background: var(--busy);
    border-radius: 8px;
    padding: 5px 11px;
    margin: 0 0 8px 4px;
    display: inline-block;
  }

  .add {
    border: 1.5px dashed var(--line);
    background: none;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 12.5px;
    font-weight: 650;
    color: var(--muted);
  }

  .add:hover {
    border-color: var(--leaf);
    color: var(--leaf);
  }

  .seg {
    display: flex;
    gap: 6px;
  }

  .seg button {
    flex: 1;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    border-radius: 10px;
    padding: 9px 4px;
    font-size: 13px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    transition: all 0.12s;
  }

  .seg button.on {
    background: var(--leaf);
    border-color: var(--leaf);
    color: #fff;
  }

  .seg button:focus-visible {
    outline: 2px solid var(--leaf);
    outline-offset: 2px;
  }

  .note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 14px;
    line-height: 1.55;
  }

  .msg {
    min-height: 20px;
    margin: 12px 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .msg.error {
    color: var(--rose);
  }

  .msg.ok {
    color: var(--leaf);
  }

  #save {
    width: 100%;
  }

  .off-lab {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    font-weight: 650;
    color: var(--muted);
    margin-top: 12px;
  }

  .off-days {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 4px;
    margin-top: 10px;
    scrollbar-width: thin;
  }

  .off-day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-width: 46px;
    border: 1px solid var(--card-brd);
    background: var(--chip-bg);
    color: var(--muted);
    border-radius: 10px;
    padding: 6px 8px;
    font-size: 10.5px;
    font-weight: 650;
    line-height: 1.25;
    flex-shrink: 0;
  }

  .off-day b {
    font-size: 14.5px;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .off-day small {
    font-size: 9.5px;
    font-weight: 600;
  }

  .off-day:hover {
    border-color: var(--rose);
  }

  .off-day.on {
    border-color: var(--rose);
    background: var(--rose-soft);
    color: var(--rose);
  }

  .off-day.on b {
    color: var(--rose);
  }

  .off-day:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
  }

  .btn.danger {
    width: 100%;
    color: var(--rose);
    border-color: var(--rose);
  }

  .btn.danger:hover {
    background: var(--rose-soft);
  }

  .card :global(.q) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .card :global(.q:last-child) {
    border-bottom: none;
  }

  .card :global(.tm) {
    font-weight: 700;
    width: 48px;
    flex-shrink: 0;
  }

  .card :global(.who) {
    flex: 1;
  }

  .card :global(.who.empty) {
    color: var(--muted);
    font-style: italic;
  }

  .card :global(.pill) {
    font-size: 11px;
    font-weight: 700;
    border-radius: 999px;
    padding: 3px 10px;
  }

  .card :global(.pill.ok) {
    color: var(--ok);
    background: var(--ok-bg);
  }

  .card :global(.pill.warn) {
    color: var(--warn);
    background: var(--warn-bg);
  }

  .card :global(.empty) {
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    padding: 18px 0;
  }
</style>
