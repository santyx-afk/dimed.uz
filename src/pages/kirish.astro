---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Kirish — Dimed klinikasi"
  description="Telegram bot orqali shaxsiy kabinetga kirish. SMS ham, parol ham kerak emas."
>
  <section class="wrap page">
    <div class="card glass">
      <div class="eyebrow">Shaxsiy kabinet</div>
      <h1>Saytga kirish</h1>
      <p class="lede">Telegram bot orqali — SMS ham, parol ham kerak emas.</p>

      <ol class="steps">
        <li>
          <b>Botga o‘ting va kontaktingizni ulashing</b>
          <a class="btn btn-sm tg" href={site.telegramBot} target="_blank" rel="noopener">
            Dimed klinikasi botini ochish
          </a>
        </li>
        <li>
          <b>Telefon raqamingizni kiriting</b>
          <input
            id="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            placeholder="+998 90 123 45 67"
            aria-label="Telefon raqami"
          />
        </li>
        <li>
          <b>Bot yuborgan 6 xonali kodni kiriting</b>
          <div class="otp-row" id="otpRow">
            {
              [1, 2, 3, 4, 5, 6].map((n) => (
                <input
                  class="otp"
                  type="text"
                  inputmode="numeric"
                  maxlength="1"
                  aria-label={`${n}-raqam`}
                />
              ))
            }
          </div>
        </li>
      </ol>

      <p class="msg" id="msg" role="status" aria-live="polite"></p>
      <button class="btn" id="submit">Kirish</button>

      <p class="help">
        Kod kelmadimi? Botga <code>/start</code> yuboring — yangi kod olasiz.<br />
        Savollar bo‘lsa: <a href={site.phoneHref}>{site.phone}</a>
      </p>
    </div>

    <!--
      Kirishdan keyingi qadam: bir telefondan butun oila foydalanadi
      (ota-ona bolasini o'z raqami bilan yozdiradi), shuning uchun
      kim kirayotganini bir marta so'raymiz.
    -->
    <div class="card glass" id="whoCard" hidden>
      <div class="eyebrow">Deyarli tayyor</div>
      <h1 id="whoTitle">Kim kirmoqda?</h1>
      <p class="lede" id="whoLede">Bu raqamga bogʻlangan bemorlar:</p>

      <div class="who-list" id="whoList"></div>

      <button class="btn btn-ghost" id="whoNew" type="button">+ Boshqa odam</button>

      <div class="who-form" id="whoForm" hidden>
        <label class="fld">
          <span>Familiya<i>*</i></span>
          <input id="w-last" type="text" autocomplete="family-name" placeholder="Yoʻldoshev" />
        </label>
        <label class="fld">
          <span>Ism<i>*</i></span>
          <input id="w-first" type="text" autocomplete="given-name" placeholder="Anvar" />
        </label>
        <label class="fld">
          <span>Sharif</span>
          <input id="w-mid" type="text" placeholder="Baxtiyorovich (ixtiyoriy)" />
        </label>
        <div class="who-actions">
          <button class="btn btn-ghost btn-sm" id="whoCancel" type="button">Bekor qilish</button>
          <button class="btn btn-sm" id="whoSave" type="button">Saqlash va davom etish</button>
        </div>
      </div>

      <p class="msg" id="whoMsg" role="status" aria-live="polite"></p>
    </div>
  </section>
</Base>

<script>
  const phoneInput = document.getElementById('phone') as HTMLInputElement;
  const otpInputs = [...document.querySelectorAll<HTMLInputElement>('#otpRow .otp')];
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const msg = document.getElementById('msg') as HTMLParagraphElement;

  const setMsg = (text: string, kind: 'error' | 'ok' | '' = '') => {
    msg.textContent = text;
    msg.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  /**
   * Kirgandan keyin qaytadigan manzil. Faqat shu saytdagi yo'l
   * qabul qilinadi — begona saytga yo'naltirishning oldini olamiz.
   */
  const safeNext = (): string => {
    const next = new URLSearchParams(location.search).get('next');
    return next && next.startsWith('/') && !next.startsWith('//') ? next : '/kabinet';
  };

  otpInputs.forEach((input, i) => {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '').slice(0, 1);
      if (input.value && i < otpInputs.length - 1) otpInputs[i + 1]?.focus();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && i > 0) otpInputs[i - 1]?.focus();
      if (e.key === 'Enter') submit.click();
    });
    input.addEventListener('paste', (e) => {
      e.preventDefault();
      const digits = (e.clipboardData?.getData('text') ?? '').replace(/\D/g, '').slice(0, 6);
      digits.split('').forEach((c, j) => {
        const box = otpInputs[j];
        if (box) box.value = c;
      });
      if (digits.length === 6) submit.click();
    });
  });

  phoneInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') otpInputs[0]?.focus();
  });

  submit.addEventListener('click', async () => {
    const phone = phoneInput.value.trim();
    const code = otpInputs.map((i) => i.value).join('');

    if (phone.replace(/\D/g, '').length < 9) {
      setMsg('Telefon raqamini to‘liq kiriting.', 'error');
      phoneInput.focus();
      return;
    }
    if (code.length !== 6) {
      setMsg('6 xonali kodni to‘liq kiriting.', 'error');
      otpInputs.find((i) => !i.value)?.focus();
      return;
    }

    submit.disabled = true;
    setMsg('Tekshirilmoqda…');

    try {
      const res = await fetch('/api/auth-verify', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ phone, code }),
      });
      const data = (await res.json()) as { error?: string };

      if (res.ok) {
        setMsg('Xush kelibsiz!', 'ok');
        await askWho();
        return;
      }

      setMsg(data.error ?? 'Kirishda xatolik.', 'error');
      otpInputs.forEach((i) => (i.value = ''));
      otpInputs[0]?.focus();
    } catch {
      setMsg('Internetga ulanishda muammo. Qayta urinib ko‘ring.', 'error');
    } finally {
      submit.disabled = false;
    }
  });

  // ---------- "Kim kirmoqda?" ----------

  type Patient = { id: string; name: string; source: '1c' | 'local' };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const go = (): void => {
    window.location.href = safeNext();
  };

  /**
   * Kirgandan keyin telefonga bog'langan bemorni tanlash.
   *
   * Bir marta so'raladi: tanlangani eslab qolinadi va keyingi
   * kirishlarda o'tkazib yuboriladi. Ro'yxat bo'sh bo'lsa —
   * darhol "yangi odam" formasi ochiladi (klinikada hali
   * ro'yxatdan o'tmagan bemor).
   */
  async function askWho(): Promise<void> {
    let data: { patients: Patient[]; activeId: string | null };
    try {
      const res = await fetch('/api/patients', { credentials: 'same-origin' });
      if (!res.ok) return go();
      data = await res.json();
    } catch {
      // Ro'yxatni olib bo'lmasa kirishni to'smaymiz.
      return go();
    }

    if (data.activeId) return go();
    if (data.patients.length === 1) {
      const only = data.patients[0];
      if (only) {
        await select(only.id);
        return;
      }
    }

    el('whoCard').hidden = false;
    el('whoCard').scrollIntoView({ behavior: 'smooth', block: 'center' });

    if (data.patients.length === 0) {
      el('whoTitle').textContent = 'Oʻzingizni tanishtiring';
      el('whoLede').textContent =
        'Bu raqam boʻyicha klinikada yozuv topilmadi. Ism-familiyangizni kiriting.';
      el('whoNew').hidden = true;
      el('whoForm').hidden = false;
      return;
    }

    el('whoList').innerHTML = data.patients
      .map(
        (p) =>
          `<button class="who-item" data-pick="${esc(p.id)}">
             <span class="who-nm">${esc(p.name)}</span>
             ${p.source === '1c' ? '<span class="who-tag">klinikada bor</span>' : ''}
           </button>`,
      )
      .join('');

    el('whoList')
      .querySelectorAll<HTMLButtonElement>('[data-pick]')
      .forEach((b) => (b.onclick = () => select(b.dataset.pick ?? '')));
  }

  const esc = (t: string) =>
    t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);

  const setWhoMsg = (text: string, kind: 'error' | '' = '') => {
    const box = el<HTMLParagraphElement>('whoMsg');
    box.textContent = text;
    box.className = `msg${kind ? ` ${kind}` : ''}`;
  };

  async function select(id: string): Promise<void> {
    setWhoMsg('Saqlanmoqda…');
    try {
      const res = await fetch('/api/patients', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'select', id }),
      });
      if (!res.ok) throw new Error(String(res.status));
      go();
    } catch {
      setWhoMsg('Saqlab boʻlmadi. Qayta urinib koʻring.', 'error');
    }
  }

  el('whoNew').addEventListener('click', () => {
    el('whoForm').hidden = false;
    el('whoNew').hidden = true;
    el<HTMLInputElement>('w-last').focus();
  });

  el('whoCancel').addEventListener('click', () => {
    el('whoForm').hidden = true;
    el('whoNew').hidden = false;
    setWhoMsg('');
  });

  el('whoSave').addEventListener('click', async () => {
    const lastName = el<HTMLInputElement>('w-last').value.trim();
    const firstName = el<HTMLInputElement>('w-first').value.trim();
    const patronymic = el<HTMLInputElement>('w-mid').value.trim();

    if (!lastName || !firstName) {
      setWhoMsg('Familiya va ism majburiy.', 'error');
      return;
    }

    setWhoMsg('Saqlanmoqda…');
    try {
      const res = await fetch('/api/patients', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'add', firstName, lastName, patronymic }),
      });
      const body = (await res.json()) as { error?: string };
      if (!res.ok) {
        setWhoMsg(body.error ?? 'Saqlab boʻlmadi.', 'error');
        return;
      }
      go();
    } catch {
      setWhoMsg('Internetga ulanishda muammo.', 'error');
    }
  });
</script>

<style>
  .page {
    padding: 56px 0 72px;
    display: flex;
    justify-content: center;
  }

  .card {
    border-radius: 22px;
    padding: 34px;
    max-width: 520px;
    width: 100%;
  }

  h1 {
    font-size: 28px;
    font-weight: 750;
  }

  .lede {
    color: var(--muted);
    font-size: 15px;
    margin-top: 8px;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 42px;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    background: var(--rose-soft);
    color: var(--rose);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .steps li b {
    display: block;
    font-size: 14.5px;
    font-weight: 650;
    margin-bottom: 10px;
  }

  .tg {
    background: var(--color-tg);
    box-shadow: 0 6px 20px -6px rgb(42 171 238 / 0.5);
  }

  #phone {
    width: 100%;
    border: 1.5px solid var(--line);
    background: var(--chip-bg);
    color: var(--ink);
    border-radius: 12px;
    padding: 12px 15px;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
    font-family: inherit;
  }

  #phone:focus {
    border-color: var(--rose);
    outline: none;
  }

  .otp-row {
    display: flex;
    gap: 8px;
  }

  .otp {
    width: 100%;
    max-width: 52px;
    height: 56px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    background: var(--chip-bg);
    color: var(--ink);
  }

  .otp:focus {
    border-color: var(--rose);
    outline: none;
  }

  .msg {
    min-height: 22px;
    margin: 20px 0 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
  }

  .msg.error {
    color: var(--rose);
  }

  .msg.ok {
    color: var(--leaf);
  }

  #submit {
    width: 100%;
  }

  .help {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.6;
  }

  .help code {
    background: var(--chip-bg);
    border: 1px solid var(--card-brd);
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 12px;
  }

  .help a {
    color: var(--rose);
    font-weight: 650;
    white-space: nowrap;
  }

  /* "Kim kirmoqda?" — kirishdan keyingi tanlov */
  .who-list {
    display: grid;
    gap: 8px;
    margin: 14px 0;
  }

  .who-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .who-item:hover,
  .who-item:focus-visible {
    border-color: var(--leaf);
    background: color-mix(in srgb, var(--leaf) 6%, var(--card));
  }

  .who-nm {
    font-weight: 650;
    font-size: 15px;
  }

  .who-tag {
    flex: none;
    font-size: 11.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 9px;
  }

  .who-form {
    display: grid;
    gap: 11px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .who-form .fld {
    display: grid;
    gap: 5px;
  }

  .who-form .fld span {
    font-size: 12.5px;
    color: var(--muted);
  }

  .who-form .fld i {
    color: var(--leaf);
    font-style: normal;
  }

  .who-form input {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--bg);
    color: inherit;
    font: inherit;
  }

  .who-form input:focus-visible {
    outline: none;
    border-color: var(--leaf);
  }

  .who-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 2px;
  }
</style>
