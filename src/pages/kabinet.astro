---
import Base from '../layouts/Base.astro';

/*
  /kabinet — eski "hammasi bir sahifada" ko'rinish bo'limlarga
  ajratildi (C1): Navbatlarim, Tahlillarim, Sozlamalar. Eski havolalar
  (bot xabarlari, xatcho'plar) ishlayverishi uchun bu manzil
  Navbatlarim'ga yo'naltiradi.
*/
---

<Base title="Shaxsiy kabinet — Dimed klinikasi" description="Qabullaringiz va tahlil natijalaringiz.">
  <meta slot="head" http-equiv="refresh" content="0; url=/kabinet/navbatlar" />
  <section class="wrap page">
    <p>Kabinetga oʻtilmoqda… <a href="/kabinet/navbatlar">Navbatlarim</a></p>
  </section>
</Base>

<script>
  window.location.replace('/kabinet/navbatlar');
</script>

<style>
  .page {
    padding: 48px 0 64px;
    min-height: 40vh;
    color: var(--muted);
  }

  .page a {
    color: var(--rose);
    font-weight: 650;
  }
</style>
